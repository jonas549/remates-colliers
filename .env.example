# ─────────────────────────────────────────────────────────────────────────────────────────────
# Remates Colliers · variables de entorno
# Copiar a .env y completar. NUNCA commitear .env (el repositorio es público).
# Los valores de NEGOCIO (incrementos, % de garantía, plazos, SMTP, textos) NO van aquí:
# se configuran desde el panel de administración (Bloque V).
# ─────────────────────────────────────────────────────────────────────────────────────────────

# ── Aplicación ──────────────────────────────────────────────────────────────────────────────
APP_NAME="Remates Colliers"
# local | production
APP_ENV=local
# Se genera una sola vez con `php artisan key:generate`. RESPALDARLA: el RUT se cifra con ella.
# Si se pierde o se cambia, los datos cifrados quedan ilegibles.
APP_KEY=
# En el servidor SIEMPRE false.
APP_DEBUG=true
APP_URL=http://remates-colliers.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Registro de errores ─────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# local: debug · servidor: warning
LOG_LEVEL=debug

# ── Base de datos ───────────────────────────────────────────────────────────────────────────
# Servidor: MariaDB (mysql). Local: mysql de Laragon, o sqlite solo para revisar pantallas.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=remates_colliers
DB_USERNAME=root
DB_PASSWORD=

# ── Sesión, caché y colas ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Servidor con https: true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database

# La cola se procesa por cron (schedule:run → queue:work --stop-when-empty). No hay worker permanente.
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Correo ──────────────────────────────────────────────────────────────────────────────────
# El SMTP definitivo se configura desde el panel (Bloque V). Esto es solo el valor inicial.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="remates@colliers.cl"
MAIL_FROM_NAME="${APP_NAME}"

# ── Remates Colliers ────────────────────────────────────────────────────────────────────────
# Primer administrador: `colliers:instalar` lo crea si no existe ninguno. Clave de 12+ caracteres;
# se obliga a cambiarla en el primer ingreso. Después de creado, se puede borrar la clave de aquí.
COLLIERS_ADMIN_NOMBRE="Administrador Colliers"
COLLIERS_ADMIN_EMAIL=
COLLIERS_ADMIN_CLAVE=

# Límite real de post_max_size del hosting (por ejemplo 32M). Vacío = el que informa PHP.
# El registro admite 3 documentos de 5 MB: si el límite es menor, PHP descarta el envío completo.
COLLIERS_LIMITE_POST=

# Sitio corporativo de Colliers: los ítems del menú y del pie que no son de esta aplicación enlazan ahí.
COLLIERS_SITIO_PRODUCCION=https://activosespeciales.colliers.cl

# Zona horaria en que se muestran las fechas (en la base todo se guarda en UTC).
COLLIERS_ZONA_VISUALIZACION=America/Santiago

VITE_APP_NAME="${APP_NAME}"

# Captcha del registro (Google reCAPTCHA v2, casilla «No soy un robot»). Vacías = registro sin captcha (local y pruebas).
# Se crean en https://www.google.com/recaptcha/admin con el dominio del sitio. Nunca en el repositorio.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Seguridad (QA 21/10). Sin definir: https forzado fuera de local/testing, HSTS de un año y CSP activa.
# COLLIERS_CSP=reporte deja la política solo informando (no bloquea); apagada la quita. Los bloqueos quedan en el log.
# COLLIERS_FORZAR_HTTPS=true
# COLLIERS_HSTS_SEGUNDOS=31536000
# COLLIERS_CSP=activa
